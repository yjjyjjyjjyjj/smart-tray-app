{
  "name": "smart-tray",
  "version": "0.2.0",
  "private": true,
  "description": "아마따 Capacitor Android app and browser preview",
  "scripts": {
    "dev": "python3 -m http.server 4173 --bind 127.0.0.1",
    "build": "node scripts/build-web.mjs",
    "sync:android": "npm run build && cap sync android",
    "open:android": "cap open android",
    "android": "npm run sync:android && cap run android",
    "test": "node --test tests/*.test.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.28.2"
  }
}
